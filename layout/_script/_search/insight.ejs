<%
var insightConfig = {
  TRANSLATION: {
    POSTS: __('insight.posts'), PAGES: __('insight.pages'),
    CATEGORIES: __('insight.categories'), TAGS: __('insight.tags')
  },
  DIALOG_LABEL: __('insight.dialog'),
  MESSAGES: {
    PROMPT: __('insight.prompt'), LOADING: __('insight.loading'),
    LOAD_ERROR: __('insight.load_error'), RETRY: __('insight.retry'),
    NO_RESULTS: __('insight.no_results'), UNTITLED: __('insight.untitled')
  },
  ROOT_URL: config.root,
  CONTENT_URL: url_for('/content.json')
};
%>
<script>window.INSIGHT_CONFIG = <%- JSON.stringify(insightConfig).replace(/</g, '\\u003c') %>;</script>
<script defer src="<%= url_for('/js/search-core.js') %>"></script>
<script defer src="<%= url_for('/js/insight.js') %>"></script>
