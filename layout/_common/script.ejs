<%- js('js/jquery.min') %>
<%- js('js/plugin.min') %>
<%- js('js/application') %>
<% if (is_post() || is_page()) { %>
<script defer src="<%= url_for('/js/reading.js') %>"></script>
<% } %>
<%- partial('_script/search') %>
<% if (page.layout === 'repository'){ %>
   <%- partial('_script/repository') %>
<% } %>
<% if (page.layout === 'books'){ %>
   <%- partial('_script/douban') %>
<% } %>
<% if (is_home() || is_post()) { %>
   <%- partial('_script/pv') %>
<% } %>
<% if (!is_home() && !is_category() && !is_tag() && !is_archive() && pure_comments_enabled(post)) { %>
   <%- partial('_script/comment') %>
<% } %>
<%- partial('_script/fancybox') %>
<%- partial('_script/analytics') %>